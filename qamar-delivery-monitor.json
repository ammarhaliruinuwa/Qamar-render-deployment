{
  "name": "Qamar Delivery Monitor v1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "7d2a3e7c-2d51-4d9d-8d5f-9d9d8f5c0a11",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-520, 0]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "delivery_assignments",
        "limit": 100
      },
      "id": "b0d3cc2f-84e0-4f3a-9c1f-20e0bba4b1c2",
      "name": "Read Delivery Assignments",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-280, 0],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "pW2qUyoNskG21wHS",
          "name": "Qamar Hair Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst cutoff = now - 24 * 60 * 60 * 1000;\nconst rows = $input.all().map(i => i.json);\nconst overdue = rows.filter(r => {\n  if (!r.assigned_at || r.acknowledged_at) return false;\n  const assigned = Date.parse(r.assigned_at);\n  return Number.isFinite(assigned) && assigned <= cutoff;\n});\nreturn overdue.map(r => ({ json: {\n  ...r,\n  monitor_event: 'DELIVERY_ACKNOWLEDGEMENT_OVERDUE',\n  escalation_level: 'OWNER_ALERT_REQUIRED',\n  overdue_hours: Math.round((now - Date.parse(r.assigned_at)) / 3600000 * 10) / 10,\n  detected_at: new Date(now).toISOString()\n} }));"
      },
      "id": "4c4b9f4e-9b11-43d8-a5d3-5f0d1d4e8a22",
      "name": "Find 24h Unacknowledged",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "strict", "version": 2},
          "conditions": [{
            "id": "hasoverdue",
            "leftValue": "={{ $input.all().length }}",
            "rightValue": 0,
            "operator": {"type": "number", "operation": "gt"}
          }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0f2c8e4-6d2a-4e4b-9e55-1f4a2d8c7b33",
      "name": "Any Overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{ json: {\n  event: 'QAMAR_DELIVERY_MONITOR',\n  status: 'OWNER_ALERT_REQUIRED',\n  overdue_assignments: items.length,\n  orders: items.map(i => i.json.order_id),\n  detected_at: new Date().toISOString(),\n  message: `Qamar delivery monitor found ${items.length} delivery assignment(s) without acknowledgement after 24 hours.`\n} }];"
      },
      "id": "f9f0e1d2-c3b4-4a5e-8f67-9a0b1c2d3e44",
      "name": "Build Owner Alert Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, -80]
    }
  ],
  "connections": {
    "Every 15 Minutes": {"main": [[{"node": "Read Delivery Assignments", "type": "main", "index": 0}]]},
    "Read Delivery Assignments": {"main": [[{"node": "Find 24h Unacknowledged", "type": "main", "index": 0}]]},
    "Find 24h Unacknowledged": {"main": [[{"node": "Any Overdue?", "type": "main", "index": 0}]]},
    "Any Overdue?": {"main": [[{"node": "Build Owner Alert Payload", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {},
  "versionId": "d2b8c4a1-1f63-4d8a-bc91-9e3a5f7c2b55",
  "meta": {"templateCredsSetupCompleted": true},
  "id": "QamarDeliveryMonitorV1",
  "tags": []
}
